# Nauka node configuration, read by the systemd unit.
# Copy to /etc/nauka/nauka.env and edit as needed.

# Cluster token, from `nauka token` — the same value on every machine of
# the cluster. This is the whole secret: anyone holding it is a member.
# Keep this file mode 640, root:nauka.
#NAUKA_TOKEN=nauka1_...

# Extra arguments passed to `nauka serve`.
#
# The first start on a blank data dir FOUNDS a single-node cluster; set
# --join to wait to be added by a member instead (what `nauka node add`
# configures). Always set --advertise to this machine's reachable address.
#
#   --listen 0.0.0.0:7311     QUIC socket (the consensus plane uses port+1)
#   --http 0.0.0.0:8080       HTTP API
#   --advertise <ip:port>     address announced to peers — the node's
#                             identity for placement and membership
#   --capacity <bytes>        storage weight; defaults to the data-dir
#                             filesystem size
#   --join                    wait to be added instead of founding
#   --scrub-interval 30       seconds between self-heal passes
#   --metrics 127.0.0.1:9100  Prometheus endpoint. Loopback by default: the
#                             exposition describes cluster topology, node
#                             capacities and peer addresses. Widen it only
#                             towards a private scrape network.
#   --no-metrics              disable the metrics endpoint entirely
#
#NAUKA_ARGS=--listen 0.0.0.0:7311 --http 0.0.0.0:8080

# Comma-separated zones served by the built-in authoritative geo-DNS.
# DNS is not exposed unless at least one zone is explicit (or
# NAUKA_HTTPS_DOMAIN supplies one). Queries outside these zones are refused.
#NAUKA_DNS_ZONES=cdn.example.com

# Paths, if you moved them.
#NAUKA_DATA_DIR=/var/lib/nauka
#NAUKA_KEYS_DIR=/etc/nauka
