[Unit]
Description=Nauka distributed storage node
Documentation=https://getnauka.com
After=network-online.target
Wants=network-online.target

[Service]
Type=exec
User=nauka
Group=nauka
# Cluster key: /etc/nauka/cluster-ca.key and .pem, copied from `nauka keygen`.
# Without it the node runs unauthenticated — see EnvironmentFile to override.
Environment=NAUKA_DATA_DIR=/var/lib/nauka
# NAUKA_TOKEN (from `nauka token`) or NAUKA_KEYS_ARG=--keys /etc/nauka —
# whichever the deployment uses. The token is read straight from the
# environment by the binary, so it never appears in `ps`.
Environment=NAUKA_KEYS_ARG=
EnvironmentFile=-/etc/nauka/nauka.env
ExecStart=/usr/bin/nauka --data-dir ${NAUKA_DATA_DIR} $NAUKA_KEYS_ARG serve $NAUKA_ARGS

Restart=always
RestartSec=5s
# Rebuilding shards after a restart is normal; give the node room to settle.
TimeoutStopSec=30s

# The built-in geo-DNS front door answers on :53, a privileged port.
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE

# Hardening. The node only ever needs its data directory and the network.
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictNamespaces=true
RestrictSUIDSGID=true
RestrictRealtime=true
LockPersonality=true
MemoryDenyWriteExecute=true
SystemCallArchitectures=native
SystemCallFilter=@system-service
ReadWritePaths=/var/lib/nauka
# Storage nodes hold many shards: one file each.
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
